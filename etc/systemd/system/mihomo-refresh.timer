[Unit]
Description=Mihomo cascade: periodic refresh of subscription and routing rules
Documentation=https://github.com/dewil/mihomo-cascade

[Timer]
Unit=mihomo-refresh.service
# Раз в две минуты, а не каждую минуту. Замер 08.09.2026 на s79: агрегатор
# подписки получает ~900 запросов в час, из них ~346 - это наши шесть машин
# каскада, и все они били в одну и ту же секунду каждой минуты. Каждый промах
# кеша разворачивается на той стороне в обход всех панелей, поэтому синхронный
# залп шести клиентов - худший из возможных профилей нагрузки. Две минуты
# снижают нашу долю вдвое.
#
# Календарная сетка, а не OnUnitActiveSec: интервал от конца прошлого прогона
# дрейфует и после каждого перезапуска таймера съезжает, а декорреляцию машин
# дает не сетка, а случайная задержка ниже.
OnCalendar=*:0/2
# Декорреляция машин между собой; прежний крон брал `shuf -i 0-59`, диапазон тот
# же. Задержка стоит здесь, а не внутри mihomo-refresh, сознательно: ручной
# прогон во время разбора должен отвечать сразу, а не спать до минуты.
RandomizedDelaySec=59s
# Обязателен явно: по умолчанию systemd вправе сдвигать запуск в окне до минуты,
# группируя пробуждения, - и эта группировка съела бы наш джиттер, вернув тот
# самый синхронный залп, против которого сделано все выше.
AccuracySec=1s

[Install]
WantedBy=timers.target
