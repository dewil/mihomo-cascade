[Unit]
Description=Mihomo cascade: refresh subscription and routing rules
Documentation=https://github.com/dewil/mihomo-cascade
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/mihomo-refresh
# Страховка от зависшего прогона - прямой аналог прежнего `timeout 300` в строке
# крона. Лока здесь нет намеренно: systemd не стартует второй экземпляр того же
# юнита, пока активен первый. Прежний `flock -n` существовал ровно потому, что
# cron запускал прогоны независимо друг от друга - на s79 такая связка дала пачку
# в ~1200 процессов и убила прокси на 7890.
TimeoutStartSec=300

# Секции [Install] нет намеренно: сервис поднимает только таймер, руками его
# включать в автозагрузку не нужно (ручной прогон - `mihomo-refresh` напрямую).
