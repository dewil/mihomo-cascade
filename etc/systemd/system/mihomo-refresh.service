[Unit]
Description=Mihomo cascade: refresh subscription and routing rules
Documentation=https://github.com/dewil/mihomo-cascade
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Лок тот же, что брал прежний крон, и он здесь не дублирует systemd. systemd
# гарантирует только одно: он не запустит второй экземпляр ЭТОГО юнита, пока
# активен первый. На чужие вызовы /usr/local/sbin/mihomo-refresh это не
# распространяется, а такие вызовы бывают: в окне миграции старый cron-прогон
# еще идет (файл cron.d снимается после того, как таймер поднят, а уже
# запущенную команду удаление файла не отменяет), плюс ручной прогон при разборе.
# Общего у прогонов достаточно, чтобы это было не про удвоение запросов:
# config.yaml.autobak, *.new и routing-rules.yaml.tmp - одни и те же файлы, то
# есть порча резервной копии и конкурирующие reload. На s79 наложение прогонов
# уже давало пачку в ~1200 процессов и убило прокси на 7890.
#
# -n: не ждать освобождения, а выходить сразу - следующий запуск через две
# минуты и так. -E 0: занятый лок - это штатный пропуск, а не сбой, поэтому код
# возврата 0; без него systemd писал бы юнит в failed на каждом пропуске, и
# journal перестал бы отличать пропуск от настоящей поломки.
ExecStart=/usr/bin/flock -n -E 0 /run/mihomo-refresh.lock /usr/local/sbin/mihomo-refresh
# Страховка от зависшего прогона - прямой аналог прежнего `timeout 300` в строке
# крона. Таймаут накрывает весь ExecStart вместе с локом. Точнее говоря, на
# 300-й секунде systemd НАЧИНАЕТ остановку (SIGTERM всей cgroup, при
# необходимости SIGKILL после TimeoutStopSec) - гарантии "ровно через пять минут
# процесса нет" здесь нет, и обещать ее не надо.
TimeoutStartSec=300

# Секции [Install] нет намеренно: сервис поднимает только таймер, руками его
# включать в автозагрузку не нужно (ручной прогон - `mihomo-refresh` напрямую).
