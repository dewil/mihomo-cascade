#!/usr/bin/env python3
"""
Тонкая обертка над Clash API работающего mihomo (external-controller).

Отвечает на вопросы, на которые по журналу приходится гадать: куда сейчас идет
трафик, по какому правилу он туда попал, какой узел выбран в группе и сколько
до него миллисекунд.

    mihomo-api conns [подстрока]   активные соединения: хост, правило, цепочка, трафик
    mihomo-api groups              группы и выбранный в каждой узел
    mihomo-api health [--json]     пассивный снимок проверок fallback-групп
    mihomo-api delay <имя> [url]   активная проба, обновляющая health-состояние

conns, groups и health только читают состояние. delay запускает проверку.
Адрес API берется из
MIHOMO_API (по умолчанию http://127.0.0.1:9090), пароль - из secret в
/etc/mihomo/config.yaml, если он там задан.
"""
from __future__ import annotations

import datetime as dt
import http.client
import json
import os
import pathlib
import sys
import urllib.error
import urllib.parse
import urllib.request

API = os.environ.get("MIHOMO_API", "http://127.0.0.1:9090")
CFG = pathlib.Path("/etc/mihomo/config.yaml")


class _NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        return None


def _secret() -> str:
    if not CFG.is_file():
        return ""
    for line in CFG.read_text(encoding="utf-8", errors="replace").splitlines():
        s = line.split("#", 1)[0].strip()
        if not s.startswith("secret:"):
            continue
        rest = s[len("secret:"):].strip()
        if len(rest) >= 2 and rest[0] == rest[-1] and rest[0] in "\"'":
            return rest[1:-1]
        return rest
    return ""


def _get(path: str, timeout: int = 10, safe_errors: bool = False):
    try:
        req = urllib.request.Request(API + path)
        sec = _secret()
        if sec:
            req.add_header("Authorization", f"Bearer {sec}")
        # health promises one request; redirects must not forward its credentials.
        open_request = (urllib.request.build_opener(_NoRedirect).open
                        if safe_errors else urllib.request.urlopen)
        with open_request(req, timeout=timeout) as r:
            return json.load(r)
    except urllib.error.HTTPError as e:
        if safe_errors:
            sys.exit(f"Не удалось прочитать состояние API: HTTP {e.code}")
        sys.exit(f"API ответил {e.code} на {path}: {e.read()[:200].decode('utf-8', 'replace')}")
    except OSError as e:
        if safe_errors:
            sys.exit("Не удалось прочитать состояние API: ошибка соединения")
        sys.exit(f"Нет связи с {API}: {e}. mihomo запущен? external-controller на месте?")
    except (ValueError, http.client.HTTPException):
        if safe_errors:
            sys.exit("Не удалось прочитать состояние API: некорректный ответ или адрес")
        raise


def _human(n: float) -> str:
    for unit in ("Б", "КБ", "МБ", "ГБ"):
        if n < 1024 or unit == "ГБ":
            return f"{n:.1f} {unit}"
        n /= 1024
    return f"{n:.1f} ГБ"


def cmd_conns(argv: list[str]) -> int:
    needle = argv[0].lower() if argv else ""
    data = _get("/connections")
    conns = data.get("connections") or []

    rows = []
    for c in conns:
        m = c.get("metadata", {})
        host = m.get("host") or m.get("sniffHost") or m.get("destinationIP") or "?"
        target = f"{host}:{m.get('destinationPort', '')}"
        chain = " <- ".join(c.get("chains") or []) or "?"
        rule = c.get("rule") or "?"
        payload = c.get("rulePayload") or ""
        traffic = (c.get("upload") or 0) + (c.get("download") or 0)
        line = f"{target} {chain} {rule} {payload}".lower()
        if needle and needle not in line:
            continue
        rows.append((traffic, target, chain, f"{rule}{'/' + payload if payload else ''}"))

    rows.sort(reverse=True)
    print(f"соединений: {len(rows)}"
          + (f" (фильтр {needle!r} из {len(conns)})" if needle else "")
          + f", всего вверх {_human(data.get('uploadTotal', 0))}"
          + f" / вниз {_human(data.get('downloadTotal', 0))}")
    if not rows:
        return 0
    print(f"{'трафик':>10}  {'назначение':<42} {'цепочка':<28} правило")
    for traffic, target, chain, rule in rows[:40]:
        print(f"{_human(traffic):>10}  {target[:42]:<42} {chain[:28]:<28} {rule}")
    if len(rows) > 40:
        print(f"... и еще {len(rows) - 40}")

    # Сводка по группам: куда трафик уходит на самом деле, а не по задумке правил.
    by_chain: dict[str, list[int]] = {}
    for traffic, _, chain, _ in rows:
        agg = by_chain.setdefault(chain.split(" <- ")[-1], [0, 0])
        agg[0] += 1
        agg[1] += traffic
    print("\nпо выходам:")
    for name, (count, traffic) in sorted(by_chain.items(), key=lambda x: -x[1][1]):
        print(f"  {name:<20} {count:>4} соед., {_human(traffic)}")
    return 0


def cmd_groups(_argv: list[str]) -> int:
    proxies = _get("/proxies").get("proxies", {})
    groups = {k: v for k, v in proxies.items()
              if v.get("type") in ("Selector", "URLTest", "Fallback", "LoadBalance")}
    for name in sorted(groups):
        g = groups[name]
        now = g.get("now") or "-"
        node = proxies.get(now, {})
        history = node.get("history") or []
        delay = f"{history[-1].get('delay')} мс" if history and history[-1].get("delay") else "нет замера"
        print(f"{name:<10} {g.get('type'):<10} -> {now:<32} {delay}")
    return 0


def cmd_delay(argv: list[str]) -> int:
    if not argv:
        sys.exit("нужно имя узла или группы: mihomo-api delay <имя> [url]")
    name = argv[0]
    url = argv[1] if len(argv) > 1 else "https://www.gstatic.com/generate_204"
    q = urllib.parse.urlencode({"url": url, "timeout": "5000"})
    res = _get(f"/proxies/{urllib.parse.quote(name)}/delay?{q}", timeout=15)
    print(f"{name}: {res.get('delay')} мс (через {url})")
    return 0


def _member_health(name, node, url, observed: dt.datetime) -> dict:
    result = {"name": name, "status": "unknown", "checked_at": None, "delay_ms": None}
    if not isinstance(node, dict) or not isinstance(url, str) or not url:
        return result
    extra = node.get("extra")
    check = extra.get(url) if isinstance(extra, dict) else None
    if not isinstance(check, dict):
        return result
    history = check.get("history")
    if not isinstance(history, list) or not history or not isinstance(history[-1], dict):
        return result
    latest = history[-1]
    timestamp = latest.get("time")
    if not isinstance(timestamp, str):
        return result
    try:
        checked = dt.datetime.fromisoformat(timestamp.replace("Z", "+00:00"))
        if checked.tzinfo is None:
            return result
        checked = checked.astimezone(dt.timezone.utc)
    except (ValueError, OverflowError):
        return result
    result["checked_at"] = checked.isoformat()
    age = (observed - checked).total_seconds()
    alive = check.get("alive")
    if not -5 <= age <= 90 or not isinstance(alive, bool):
        return result
    if not alive:
        result["status"] = "down"
    else:
        delay = latest.get("delay")
        if type(delay) is int and delay >= 0:
            result.update(status="up", delay_ms=delay)
    return result


def cmd_health(argv: list[str]) -> int:
    if argv not in ([], ["--json"]):
        sys.exit("использование: mihomo-api health [--json]")
    data = _get("/proxies", safe_errors=True)
    if not isinstance(data, dict) or not isinstance(data.get("proxies"), dict):
        sys.exit("Не удалось прочитать состояние API: некорректный список proxies")
    observed = dt.datetime.now(dt.timezone.utc)
    proxies = data["proxies"]
    groups = []
    for name, group in proxies.items():
        if not isinstance(group, dict) or group.get("type") != "Fallback":
            continue
        names = group.get("all")
        members = []
        if isinstance(names, list):
            for member_name in names:
                valid_name = isinstance(member_name, str)
                members.append(_member_health(
                    member_name if valid_name else None,
                    proxies.get(member_name) if valid_name else None,
                    group.get("testUrl"), observed))
        states = [member["status"] for member in members]
        status = ("available" if "up" in states else
                  "all_down" if states and all(state == "down" for state in states) else
                  "unknown")
        selected = group.get("now")
        groups.append({"name": name, "selected": selected if isinstance(selected, str) else None,
                       "status": status, "members": members})
    report = {"schema_version": 1, "observed_at": observed.isoformat(), "groups": groups}
    if argv:
        print(json.dumps(report, ensure_ascii=False))
        return 0
    print(f"Снимок проверок: {report['observed_at']}")
    labels = {"up": "доступен", "down": "недоступен", "unknown": "не определено",
              "available": "есть доступный участник", "all_down": "все участники недоступны"}
    for group in groups:
        print(f"{group['name']}: {labels[group['status']]}; выбран: {group['selected'] or '-'}")
        if group["status"] == "all_down":
            print("  Выбор первой ноды не означает ее доступность.")
        for member in group["members"]:
            delay = f"{member['delay_ms']} мс" if member["delay_ms"] is not None else "-"
            print(f"  {member['name'] or '?'}: {labels[member['status']]}; "
                  f"проверка: {member['checked_at'] or '-'}; задержка: {delay}")
    return 0


COMMANDS = {"conns": cmd_conns, "groups": cmd_groups, "delay": cmd_delay, "health": cmd_health}


def main() -> int:
    argv = sys.argv[1:]
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(__doc__.strip())
        return 0
    cmd = COMMANDS.get(argv[0])
    if not cmd:
        sys.exit(f"неизвестная команда {argv[0]!r}. Есть: {', '.join(COMMANDS)}")
    return cmd(argv[1:])


if __name__ == "__main__":
    raise SystemExit(main())
